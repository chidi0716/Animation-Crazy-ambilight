{
  "manifest_version": 3,
  "name": "動畫瘋環境光",
  "description": "在巴哈姆特動畫瘋的影片周圍加上環境光，看動畫更有沉浸感！（非官方擴充功能，改編自 Wessel Kroos 的 Ambient light for YouTube）",
  "version": "0.0.0",
  "homepage_url": "https://github.com/chidi0716/Animation-Crazy-ambilight",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "128": "images/icon-128.png"
  },
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "121.0",
      "id": "{bae26885-9fca-4dcb-8d5e-64ae47fa1b36}"
    }
  },
  "action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "24": "images/icon-24.png",
      "32": "images/icon-32.png"
    },
    "default_popup": "options.html"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ani.gamer.com.tw/animeVideo.php*"
      ],
      "js": [
        "scripts/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles/content.css",
        "scripts/content-main.js",
        "scripts/injected.js",
        "images/noise-1.png",
        "images/noise-2.png",
        "images/noise-3.png"
      ],
      "matches": [
        "https://ani.gamer.com.tw/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": [
    "storage"
  ]
}
